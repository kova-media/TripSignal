# PostgreSQL database used to persist alerts and delivered signals.
DATABASE_URL=postgres://user:password@host:5432/tripsignal

# Resend API key used for transactional alert email.
RESEND_API_KEY=re_...

# Verified sender identity in Resend. Example: TripSignal Alerts <signals@your-domain.com>
ALERT_FROM_EMAIL=TripSignal Alerts <signals@your-domain.com>

# Protects the scheduled alert worker from public requests.
CRON_SECRET=replace-with-a-long-random-secret
