# PostgreSQL database used to persist alerts and delivered signals.
DATABASE_URL=postgres://user:password@host:5432/tripsignal

# Resend API key used for transactional alert email.
RESEND_API_KEY=re_...

# Verified sender identity in Resend. This address sends automated alerts and is not used for inbound support.
ALERT_FROM_EMAIL=TripSignal Alerts <alerts@tripsignal.travel>

# Email address that receives messages submitted through the public contact form.
# It also receives an alert if the scheduled fare-check worker fails.
CONTACT_EMAIL=your-email@example.com

# Protects the scheduled alert worker from public requests.
CRON_SECRET=replace-with-a-long-random-secret

# Stripe secret key used for the TripSignal Pro checkout.
STRIPE_SECRET_KEY=sk_...

# TripSignal production email and billing configuration is read at runtime from Vercel.

# Optional: SMS fare alerts via Twilio. Leave unset to keep SMS disabled.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1XXXXXXXXXX
